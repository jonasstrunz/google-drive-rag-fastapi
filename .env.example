# Application Configuration
APP_NAME=Google Drive RAG API
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Google OAuth2 Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
GOOGLE_SCOPES=https://www.googleapis.com/auth/drive.readonly,https://www.googleapis.com/auth/userinfo.email,https://www.googleapis.com/auth/userinfo.profile
TOKEN_STORAGE_PATH=./data/tokens.json

# Qdrant Vector Database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=google_drive_rag
QDRANT_VECTOR_SIZE=1536
# Set to true to use in-memory Qdrant (great for local testing without running Qdrant server)
QDRANT_IN_MEMORY=false

# LLM & Embedding Settings
# Provider options: "openai", "openrouter", or "mock"
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# OpenRouter Settings
# LLM Provider options: "openai", "openrouter", or "fallback"
LLM_PROVIDER=openai
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_HTTP_REFERER=https://github.com/jonasstrunz/google-drive-rag-fastapi
OPENROUTER_TITLE=Google Drive RAG API

# RAG & Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K_RESULTS=5
SIMILARITY_THRESHOLD=0.7
